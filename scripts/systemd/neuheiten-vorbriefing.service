[Unit]
Description=bikosoc Vorlauf-Suche 15 Minuten vor dem Briefing (Neuheiten + Gesendet + Yahoo alle Ordner, nur lesend; Zuordnungsfragen fürs Briefing)
Documentation=file:///home/biko/bikosoc-spec/report-paket-briefing-kalender-volksbank-20261107.md

[Service]
Type=oneshot
WorkingDirectory=%h/.openclaw/workspace/.openclaw/extensions/executive-agent
ExecStart=/home/biko/.bun/bin/bun scripts/neuheiten-stunde.ts --vorbriefing
EnvironmentFile=-%h/.config/openclaw/env
# Das Skript bricht selbst nach 10 Minuten ab und schreibt den Abbruch in die
# Zustandsdatei; systemd ist nur die zweite Grenze.
TimeoutStartSec=12min
