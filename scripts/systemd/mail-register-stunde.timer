[Unit]
Description=bikosoc Mail-Register stündlich (Minute 7)

[Timer]
# Owner-Anweisung 27.10.2026: beide Postfaecher alle 1 h pruefen. Minute 7,
# damit der Lauf nicht mit den 5-Minuten-Timern (data@, Eingangskanal) und
# dem stuendlichen Rest auf Minute 0 zusammenfaellt.
OnCalendar=*-*-* *:07:00
AccuracySec=1min
# Ein verpasster Lauf wird nicht nachgeholt; der naechste deckt 48 h ab.
Persistent=false

[Install]
WantedBy=timers.target
