#!/usr/bin/env bash
# STILLGELEGT am 16.10.2026 — Owner-Entscheidung: Betrieb ueber den eigenen
# Chrome des Owners.
#
# Der serverseitige Login ist zweimal gemessen worden und scheitert an
# Cloudflare Turnstile: headless am 13.10., im sichtbaren Browser unter Xvfb am
# 14.10., beide Male Fehler 600010 ("Bot behavior detected"). Am 16.10. wurde
# nachgeprueft, dass das Portal Turnstile unveraendert einsetzt.
#
# Daraus folgt: Auf dem Server wird kein Passwort mehr gebraucht und keines
# mehr entgegengenommen. Wo kein Passwort liegt, kann auch keines abhanden
# kommen.
#
# Geloescht ist nichts. Diese Datei und die Mehrkontentechnik bleiben stehen;
# ein Revert des zugehoerigen Commits stellt den alten Zustand her, falls das
# Portal den Bot-Schutz je abschaltet.
#
# casameta-credentials [objekt] — Zugangsdaten für das Casameta-Portal hinterlegen.
#
# Nur der Owner führt das aus. Der Agent schreibt diese Datei nie selbst.
# Das Skript gibt weder Benutzername noch Passwort aus — auch nicht die Länge.
#
# MEHRERE KONTEN. Casameta führt je Objekt einen eigenen Zugang. Das Objekt wird
# als Argument übergeben oder abgefragt:
#     ~/bin/casameta-credentials mg24
#     ~/bin/casameta-credentials n24
# Jeder Zugang wird in dieselbe Datei geschrieben, aber unter eigenen Schlüsseln.
# Ein bereits hinterlegtes anderes Objekt bleibt dabei erhalten.
set -euo pipefail

# ── Stillgelegt: keine Passwortannahme mehr ────────────────────────────────
cat >&2 <<'ENDE'
Casameta wird seit dem 16.10.2026 ueber den Chrome des Owners bedient.

Der Server nimmt deshalb kein Passwort mehr entgegen. Der serverseitige Login
ist zweimal gemessen worden und scheitert an Cloudflare Turnstile (Fehler
600010) — headless wie im sichtbaren Browser. Ein hinterlegtes Passwort haette
dort keinen Nutzen, nur ein Risiko.

So arbeiten Sie stattdessen:

  1. ~/bin/casameta-run <auftrag.md> --objekt <code> --jahr <jjjj>
     Das legt den Lauf an und schreibt den fertigen Auftragstext.
  2. Den Text in Ihrem Chrome an Claude uebergeben; Sie sind dort angemeldet.
  3. Das Ergebnis zurueck in den Lauf-Ordner legen; das Protokollskript
     uebernimmt es wie bisher.

Soll der Serverweg je wieder moeglich werden (nur sinnvoll, wenn das Portal
den Bot-Schutz abschaltet), nimmt ein Revert des Commits vom 16.10.2026 diese
Sperre zurueck.
ENDE
exit 3


ZIEL_DIR="$HOME/.config/biko-portals"
ZIEL="$ZIEL_DIR/env"
AGENT="$HOME/.openclaw/workspace/.openclaw/extensions/executive-agent"

# ── PATH haerten ────────────────────────────────────────────────────────────
# `ssh host befehl` startet eine NICHT-interaktive Shell. ~/.bashrc bricht dort
# in Zeile 6 ab ("If not running interactively, don't do anything") — und genau
# danach stehen die PATH-Zeilen fuer bun und npm-global. Ohne dieses Haerten
# endet der Aufruf mit "bun: command not found"; so geschehen am 13.10.2026 beim
# ersten Login-Test des Owners, der dadurch "Login fehlgeschlagen" ohne Grund
# meldete, obwohl das Portal nie kontaktiert wurde.
export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
export PATH="$BUN_INSTALL/bin:$HOME/.npm-global/bin:$HOME/.local/bin:$PATH"

werkzeug_pruefen() {
  local fehlt=""
  for w in "$@"; do command -v "$w" >/dev/null 2>&1 || fehlt="$fehlt $w"; done
  if [ -n "$fehlt" ]; then
    echo "Abbruch: nicht auffindbar:$fehlt" >&2
    echo "Bitte melden — der Suchpfad des Servers ist unvollstaendig." >&2
    exit 1
  fi
}

werkzeug_pruefen bun

printf 'Zugangsdaten Casameta-Portal (portal.casameta.de)\n\n'

# ── Objekt bestimmen ────────────────────────────────────────────────────────
OBJEKT="${1:-}"
if [ -z "$OBJEKT" ]; then
  printf 'Für welches Objekt? (mg24 oder n24)\n'
  read -r -p 'Objekt: ' OBJEKT
fi
OBJEKT="$(printf '%s' "$OBJEKT" | tr '[:upper:]' '[:lower:]')"
if ! printf '%s' "$OBJEKT" | grep -qE '^[a-z0-9]{2,12}$'; then
  echo 'Abbruch: Objektkennung darf nur Buchstaben und Ziffern enthalten.' >&2
  exit 1
fi
GROSS="$(printf '%s' "$OBJEKT" | tr '[:lower:]' '[:upper:]')"
SCHL_USER="CASAMETA_${GROSS}_USER"
SCHL_PASS="CASAMETA_${GROSS}_PASSWORD"

printf 'Objekt: %s  (Schlüssel %s / %s)\n\n' "$OBJEKT" "$SCHL_USER" "$SCHL_PASS"

read -r -p 'Benutzername (E-Mail): ' CM_USER
if [ -z "${CM_USER:-}" ]; then echo 'Abbruch: kein Benutzername.' >&2; exit 1; fi

read -r -s -p 'Passwort: ' CM_PASS; printf '\n'
if [ -z "${CM_PASS:-}" ]; then echo 'Abbruch: kein Passwort.' >&2; exit 1; fi

read -r -s -p 'Passwort wiederholen: ' CM_PASS2; printf '\n'
if [ "$CM_PASS" != "$CM_PASS2" ]; then echo 'Abbruch: Passwörter stimmen nicht überein.' >&2; exit 1; fi
unset CM_PASS2

mkdir -p "$ZIEL_DIR"
chmod 700 "$ZIEL_DIR"
umask 077

# ── Schreiben, ohne andere Objekte zu verlieren ─────────────────────────────
# Die Datei wird neu aufgebaut: alle Zeilen ausser denen dieses Objekts werden
# uebernommen, danach kommen die neuen. Ueber eine temporaere Datei im selben
# Verzeichnis und `mv`, damit bei einem Abbruch nie eine halbe Datei stehen
# bleibt. Die alte Fassung wurde frueher komplett ueberschrieben — damit haette
# das Hinterlegen des zweiten Objekts das erste geloescht.
TMP="$(mktemp "$ZIEL_DIR/.env.XXXXXX")"
chmod 600 "$TMP"
if [ -f "$ZIEL" ]; then
  grep -v -E "^(${SCHL_USER}|${SCHL_PASS})=" "$ZIEL" > "$TMP" || true
else
  printf '# Zugangsdaten Portale. Angelegt von casameta-credentials.\n' > "$TMP"
fi
{
  printf '%s=%s\n' "$SCHL_USER" "$CM_USER"
  printf '%s=%s\n' "$SCHL_PASS" "$CM_PASS"
} >> "$TMP"
unset CM_PASS
mv -f "$TMP" "$ZIEL"
chmod 600 "$ZIEL"

printf '\nGespeichert: %s (nur für Sie lesbar)\n' "$ZIEL"
printf 'Hinterlegte Objekte: '
( cd "$AGENT" && bun run scripts/casameta-login.ts --konten ) 2>/dev/null || printf '\n'
printf 'Login-Test für %s läuft — das kann wegen der Cloudflare-Prüfung bis zu einer Minute dauern.\n\n' "$OBJEKT"

cd "$AGENT"
# Das Protokoll bleibt im Fehlerfall liegen. Es enthaelt keine Eingabewerte:
# casameta-login.ts gibt Benutzername und Passwort nirgends aus. Ohne diese
# Datei war am 13.10.2026 nicht feststellbar, woran der Test scheiterte.
LOG="$HOME/.local/share/biko-portals/casameta/logintest-$OBJEKT.log"
mkdir -p "$(dirname "$LOG")"
if bun run scripts/casameta-login.ts --erzwingen --konto "$OBJEKT" >"$LOG" 2>&1; then
  echo "Login OK ($OBJEKT)"
  exit 0
else
  echo "Login fehlgeschlagen ($OBJEKT)"
  # Grund des Skripts, sonst die letzte Zeile der Ausgabe (etwa ein
  # Werkzeugfehler der Shell) — damit nie eine grundlose Meldung stehen bleibt.
  grep -o 'Login fehlgeschlagen:.*' "$LOG" | head -1 || tail -1 "$LOG"
  grep -o 'Letzter Schritt:.*' "$LOG" | head -1 || true
  echo "Einzelheiten: $LOG"
  exit 1
fi
